        <mxCell id="title" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#333333;strokeWidth=1.5;fontFamily=Helvetica;align=center;verticalAlign=middle;fontStyle=1;fontSize=14;fontColor=#111111;" value="Alur Perencanaan dan Pelaksanaan Aplikasi Calora" vertex="1">
          <mxGeometry height="44" width="480" x="173.5" y="40" as="geometry" />
        </mxCell>
        <mxCell id="step1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;fontColor=#1A1A1A;fontSize=12;" value="&lt;b&gt;1. Analisis Kebutuhan&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size: 11px;&quot;&gt;Analisis permasalahan dan kebutuhan pengguna&lt;/font&gt;" vertex="1">
