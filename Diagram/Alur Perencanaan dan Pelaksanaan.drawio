        <mxCell id="step5" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;fontColor=#1A1A1A;fontSize=12;" value="&lt;b&gt;5. Perancangan Database&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size: 11px;&quot;&gt;Merancang struktur data dan ERD&lt;/font&gt;" vertex="1">
