            const SizedBox(height: 24),
            _SectionTitle(title: "Today's Insights", isDark: isDark),
            const SizedBox(height: 12),
            _InsightCard(
              remaining: remaining,
              isDark: isDark,
            ),
          ],
        ),
      ),
        ],
      ),
    );
  }

  String _goalLabel(Goal goal) {
    switch (goal) {
      case Goal.loseWeight:
